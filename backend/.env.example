# Going Twice API environment.
#
# Local development: copy to `.env`, then set:
#   ENVIRONMENT=local
#   DATABASE_URL_OVERRIDE=sqlite:///./goingtwice.db
#   CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
#   FRONTEND_URL=http://localhost:3000
#
# Production (Dokploy): copy into the Environment tab.
# Leave DATABASE_URL_OVERRIDE unset so POSTGRES_* is used.
# Compose interpolates ${VAR}. Postgres is a separate service — do not run a
# DB container in this stack.
#
# The API refuses to boot when ENVIRONMENT=production|prod|live if JWT is the
# default, SQLite is in use, CORS/FRONTEND_URL still point at localhost, or
# mail is still the console logger.

# ── Database (external Dokploy service) ───────────────────────────────
POSTGRES_SERVER=your-postgres-host
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=goingtwice
POSTGRES_PORT=5432
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# Never set this in production. Local SQLite only:
# DATABASE_URL_OVERRIDE=sqlite:///./goingtwice.db

# ── API ───────────────────────────────────────────────────────────────
API_PORT=8000
ENVIRONMENT=production
PROJECT_NAME=Going Twice API
# No trailing slashes. List every live origin the browser uses (apex + www).
CORS_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com
FRONTEND_URL=https://your-frontend-domain.com
GLOBAL_RATE_LIMIT=120/minute

# ── JWT ───────────────────────────────────────────────────────────────
# openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-long-random-secret-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Auth ──────────────────────────────────────────────────────────────
PASSWORD_MIN_LENGTH=6
BCRYPT_ROUNDS=12
AUTH_ALLOW_MAGIC_OTP_BYPASS=false
AUTH_EXPOSE_VERIFICATION_CODE=false
PASSWORD_RESET_EXPIRE_MINUTES=60

# ── Email ─────────────────────────────────────────────────────────────
# MAIL_ENABLED=false logs every message instead of delivering it.
# Pick a provider: console | resend | smtp
# ZeptoMail: smtp.zeptomail.com:587 + STARTTLS. From must be a verified sender.
MAIL_ENABLED=true
MAIL_PROVIDER=smtp
MAIL_FROM=noreply@your-domain.com
MAIL_FROM_NAME=Going Twice
MAIL_API_KEY=
MAIL_TIMEOUT_SECONDS=20

# Only needed when MAIL_PROVIDER=smtp
SMTP_HOST=smtp.zeptomail.com
SMTP_PORT=587
SMTP_USERNAME=noreply@your-domain.com
SMTP_PASSWORD=change-me
SMTP_USE_TLS=true

# Staff inbox for /contact (comma-separated). Admins are emailed as well.
CONTACT_INBOX=hello@your-domain.com

# ── Email verification (OTP) ──────────────────────────────────────────
EMAIL_VERIFICATION_CODE_LENGTH=6
EMAIL_VERIFICATION_EXPIRE_MINUTES=10
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# ── Listing photos ────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8
MAX_UPLOAD_FILES=7
