# Local
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production (Dokploy build-time arguments — Next.js inlines NEXT_PUBLIC_* at build)
# NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.com/api/v1
# NEXT_PUBLIC_SITE_URL=https://your-frontend-domain.com

# Serve the bundled sample catalog when the API call fails.
# Development aid only — leave unset (or false) everywhere else so a backend
# outage surfaces as a real error instead of fake, unbuyable inventory.
NEXT_PUBLIC_USE_MOCK_DATA=false
